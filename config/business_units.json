        "source_label": "Packaged demonstration dataset; replace from Admin before operational use",
        "is_demo": true
      },
      "kpis": [
        {"column": "feed_ic4_ratio", "label": "Average feed iC4 ratio", "aggregate": "mean", "unit": "%", "decimals": 1, "target": 40},
        {"column": "product_ic4_ratio", "label": "Average product iC4 ratio", "aggregate": "mean", "unit": "%", "decimals": 1, "target": 85},
        {"column": "ic4_improvement", "label": "Average iC4 improvement", "aggregate": "mean", "unit": "pts", "decimals": 1, "target": 45},
