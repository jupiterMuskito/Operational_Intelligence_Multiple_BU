      },
      "sops": {
        "seed": [
          {"title": "Sample reference – Butamer unit startup", "category": "SOP", "unit": "Butamer", "version": "Upload approved revision"},
          {"title": "Sample reference – Reactor changeover", "category": "Operating guidance", "unit": "Reactor section", "version": "Upload approved revision"},
          {"title": "Sample reference – Feed and product sampling", "category": "Checklist", "unit": "Butamer", "version": "Upload approved revision"}
        ]
