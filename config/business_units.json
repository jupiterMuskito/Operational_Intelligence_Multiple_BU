          {"tag": "TI-2201", "label": "Reactor A inlet temperature", "unit": "°C", "dcs_column": "reactor_a_inlet_c", "tolerance": 2.0, "default": 145.0},
          {"tag": "TI-2202", "label": "Reactor A outlet temperature", "unit": "°C", "dcs_column": "reactor_a_outlet_c", "tolerance": 2.0, "default": 154.0},
          {"tag": "PI-2301", "label": "Stabilizer pressure", "unit": "bar(g)", "dcs_column": "stabilizer_pressure_barg", "tolerance": 0.2, "default": 7.5}
